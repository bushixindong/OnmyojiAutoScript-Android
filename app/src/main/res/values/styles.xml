<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="OasNativeTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#6750A4</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">#FFFBFF</item>
        <item name="android:navigationBarColor">#F7F2FA</item>
        <item name="android:windowBackground">#FFFBFF</item>
        <item name="android:colorControlHighlight">#186750A4</item>
    </style>
    <style name="OasNativeTheme.Dark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#D0BCFF</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">#313033</item>
        <item name="android:colorBackground">#313033</item>
    </style>
</resources>
